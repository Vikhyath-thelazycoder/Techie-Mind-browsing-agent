# Techie Mind — environment template.
# Copy to .env for local development. NEVER commit real values (.env is git-ignored).
# The browser extension itself reads no secrets: credentials live server-side only (spec §40, §65–66).

# ── Model gateway (Phase 3) ─────────────────────────────────────────────
# OpenAI-compatible provider used by the server-side gateway. Receives sanitized context only.
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=

# ── Local models (Phase 3) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
LAYA_ADAPTER_URL=http://127.0.0.1:8765
# Shared secret for the authenticated localhost Laya adapter.
LAYA_ADAPTER_TOKEN=

# ── Monitoring backend (Phase 8) ────────────────────────────────────────
DATABASE_URL=
MONITOR_API_TOKEN_SECRET=

# ── Notifications (Phase 8) ─────────────────────────────────────────────
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
