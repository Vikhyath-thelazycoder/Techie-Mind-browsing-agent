{
  "name": "techie-mind",
  "version": "0.1.0",
  "private": true,
  "description": "Techie Mind — privacy-first autonomous browser agent (SIH26171).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @techie-mind/extension",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --project=browser",
    "lint:firefox": "web-ext lint --source-dir apps/extension/dist/firefox --self-hosted",
    "verify": "node scripts/verify/phase6.mjs all",
    "test:live": "playwright test --project=live",
    "verify:phase0": "node scripts/verify/phase0.mjs all",
    "verify:phase1": "node scripts/verify/phase1.mjs all",
    "bench:models": "tsx scripts/bench/models.ts",
    "verify:phase2": "node scripts/verify/phase2.mjs all",
    "verify:phase3": "node scripts/verify/phase3.mjs all",
    "verify:phase4": "node scripts/verify/phase4.mjs all",
    "verify:phase5": "node scripts/verify/phase5.mjs all",
    "verify:phase6": "node scripts/verify/phase6.mjs all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7",
    "web-ext": "^10.7.0"
  }
}
